# MewHelp 售后 MCP 服务守护(部署于 /etc/systemd/system/)
[Unit]
Description=MewHelp aftersales MCP server
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/app
EnvironmentFile=/home/ubuntu/app/.env.production
ExecStart=/home/ubuntu/app/.venv/bin/python mcp_servers/aftersales_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
