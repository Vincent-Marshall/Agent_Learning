# MewHelp FastAPI 应用守护(部署于 /etc/systemd/system/)
[Unit]
Description=MewHelp FastAPI application
After=network.target docker.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/app
EnvironmentFile=/home/ubuntu/app/.env.production
ExecStart=/home/ubuntu/app/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
