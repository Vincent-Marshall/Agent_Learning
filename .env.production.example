# 生产环境配置模板:cp .env.production.example .env.production 后填入真值。
# .env.production 已被 .gitignore 挡住,永不入库;本模板只含占位符。

# ---- 模型上游(必填)----
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-v4-flash
CHAT_API_KEY=sk-xxx
CHAT_THINKING=adaptive
CHAT_REASONING_SPLIT=true

# ---- 嵌入 / 重排(必填)----
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=sk-xxx
EMBED_MODEL=BAAI/bge-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=sk-xxx
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- 数据层(生产库)----
DATABASE_URL=mysql+asyncmy://root:CHANGE_ME_PASSWORD@localhost:3306/mewhelp
TOKEN_BUDGET=2000

# ---- MCP 服务地址(本机部署)----
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp

# ---- Langfuse(可选;小配置服务器建议留空=关闭)----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# ---- 密钥管理规范 ----
# 1. 真值只存在于服务器上的 .env.production,绝不出现在仓库/聊天记录/截图。
# 2. MySQL 密码用独立强口令,别与上游 API key 复用。
# 3. 轮换任一上游 key 时只改这一份文件,改完重启对应服务即生效。
